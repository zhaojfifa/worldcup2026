# =========================
# WorldCup2026 MVP Env Example
# Copy this file to .env for local development.
# Never commit .env.
# =========================

# App
APP_ENV=development
APP_NAME=worldcup2026
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000

# Database
DATABASE_URL=postgresql://worldcup2026:password@localhost:5432/worldcup2026

# API-FOOTBALL / API-Sports
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
API_FOOTBALL_KEY=replace_with_your_api_key

# Optional data source fallback
ENABLE_CSV_FALLBACK=true

# AI Provider
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=replace_with_your_deepseek_key
KIMI_API_KEY=replace_with_your_kimi_key

# Cloudflare R2
R2_ACCOUNT_ID=replace_with_account_id
R2_ACCESS_KEY_ID=replace_with_access_key_id
R2_SECRET_ACCESS_KEY=replace_with_secret_access_key
R2_BUCKET=worldcup2026
R2_PUBLIC_BASE_URL=https://example-r2-public-url

# Token Rules
MTC_DAILY_CHECKIN=10
MTC_SHARE_REWARD=50
MTC_INVITE_REWARD=100
MTC_REPORT_UNLOCK_COST=390
MTC_COMMUNITY_TRIAL_COST=1500

# Compliance
ENABLE_REAL_MONEY_BETTING=false
ENABLE_TOKEN_WITHDRAWAL=false
