# Frontend environment variables
# Copy to .env.local for local development.
# On Render: set these in Dashboard → Environment (no file needed).

# API base URL
# Local dev:
VITE_API_BASE_URL=http://localhost:8000
# Render production:
# VITE_API_BASE_URL=https://worldcup2026-api-71n6.onrender.com

# Toggle mock data (true = use mock.ts, false = call real API)
# Local dev:
VITE_USE_MOCK=true
# Render production:
# VITE_USE_MOCK=false
